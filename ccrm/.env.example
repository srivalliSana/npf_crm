# ─── CCRM Environment Variables (copy this to .env and fill in values) ────────

# Allowed email domains for login (comma-separated, no spaces)
VITE_ALLOWED_DOMAINS=cutm.ac.in,cutmap.ac.in

# App name & branding
VITE_APP_NAME=CCRM
VITE_APP_FULL_NAME=Centurion CRM
VITE_ORG_NAME=Centurion University of Technology and Management

# Min password length
VITE_MIN_PASSWORD_LENGTH=6

# Support contact shown on login error
VITE_SUPPORT_EMAIL=it-support@cutm.ac.in

# Google OAuth – get from https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
